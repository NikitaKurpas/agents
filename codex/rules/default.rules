prefix_rule(pattern=["codex", "execpolicy"], decision="allow")
prefix_rule(pattern=["git", ["diff", "status"]], decision="allow")
prefix_rule(
    pattern=[
        [
            "jq",
            "axe",
            "xcodegen",
            "xcp",
            "xcdiff",
            "xcbeautify",
            "xcsift",
            "lldb",
            "xcodebuildmcp"
        ]
    ],
    decision="allow"
)
prefix_rule(pattern=["docker", ["run", "ps", "images", "inspect", "logs", "version", "info"]], decision="allow")
prefix_rule(pattern=["tofu"], decision="prompt")