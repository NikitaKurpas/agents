prefix_rule(
    pattern = [["/bin/zsh", "/bin/bash"], "-lc", [
        "xcodebuild",
        "xcrun",
        "log",
        "/usr/bin/log",
        "simctl",
        "xctrace"
    ]],
    decision = "allow"
)
prefix_rule(
    pattern = ["xcodebuild"], decision = "allow"
)
prefix_rule(
    pattern = ["xcrun"], decision = "allow"
)
prefix_rule(
    pattern = [["log", "/usr/bin/log"]], decision = "allow"
)
prefix_rule(
    pattern = ["simctl"], decision = "allow"
)
prefix_rule(
    pattern = ["xctrace"], decision = "allow"
)
