#!/usr/bin/env -S deno run -q --allow-env --allow-run --allow-sys --allow-read --allow-write --allow-net

// ideas:
// - https://github.com/jaywcjlove/html-to-markdown-cli/blob/main/packages/html-to-markdown/src/index.ts
// - https://github.com/mmdclx/url-to-markdown-cli-tool/tree/main/src

import puppeteer from "npm:puppeteer";
import turndown from "npm:turndown";

function printHelp() {
  console.log(`Usage: markrawl [options] <url> [output-file]

Convert a web page to Markdown and write it to a file.

Arguments:
  <url>          URL to fetch and convert
  [output-file]  Destination path (default: temp file in /tmp)

Options:
  -h, --help     Show this help message
`);
}

async function fetchUrlToMarkdown(url) {
  const browser = await puppeteer.launch({
    headless: true,
    args: ["--no-sandbox"],
  });
  const page = await browser.newPage();
  await page.goto(url, { waitUntil: "networkidle2" });
  const html = await page.content();
  await browser.close();

  const td = new turndown();
  const md = td.turndown(html);
  return md;
}

(async () => {
  const args = [...Deno.args];

  if (args.includes("--help") || args.includes("-h")) {
    printHelp();
    process.exit(0);
  }

  const url = args[0];
  const output = args[1] ?? (await Deno.makeTempFile({dir: "/tmp", suffix: ".md" }));

  if (!url) {
    printHelp();
    process.exit(1);
  }

  const md = await fetchUrlToMarkdown(url);
  Deno.writeTextFileSync(output, md);
  console.log(`Page saved to ${output}`);
})();
